#!/usr/bin/env python3
"""The `athos` command, as hooks, slash commands and agents call it: `python3 bin/athos <command> ...`.

Nothing has to be installed first. The package that sits next to this folder goes first on the import path, so a
plugin copy, an app copy or a git checkout each runs its own code, whatever else is on the machine.
"""
import sys
from pathlib import Path


def _run_from_here() -> int:
    package_root = Path(__file__).resolve().parent.parent
    sys.path.insert(0, str(package_root))
    from athos.cli import main as cli_main

    return cli_main()


if __name__ == "__main__":
    sys.exit(_run_from_here())
