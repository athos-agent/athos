# Copy to ~/.athos/.env and fill in your own key. Athos reads it there; it is never printed or committed.
# Meta Model API (Muse Spark), used by `athos bench --agents meta` and `athos delegate --backend meta`.
MODEL_API_KEY=
# Optional: Baseten Model APIs (Muse Spark Open), for `--agents baseten` / `--backend baseten`.
BASETEN_API_KEY=
